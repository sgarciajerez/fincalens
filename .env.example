# The development server binds only to loopback. No production authentication is configured.
# Optional: PostgreSQL. If absent, local development uses work/data/fincalens.sqlite.
# DATABASE_URL=postgresql://fincalens:YOUR_PASSWORD@127.0.0.1:5432/fincalens
API_PORT=4174
# Optional local multi-account mode. Requires HTTPS plus COOKIE_SECURE=true in production.
# It does not include email verification, password recovery, or production deployment hardening.
AUTH_MODE=local
COOKIE_SECURE=false
# WEB_ORIGIN=http://127.0.0.1:4173
