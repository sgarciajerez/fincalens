# Local development defaults. Copy to .env and adjust only when needed.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4174
WEB_ORIGIN=http://127.0.0.1:4173
AUTH_MODE=local
COOKIE_SECURE=false
TRUST_PROXY=false
SQLITE_PATH=work/data/fincalens.sqlite
